{
	"id": "19-undeclared-plugin",
	"title": "A plugin made before agent access existed",
	"prompt": "What's in my notes?",
	"persona": "Person chatting with Claude Desktop, with a notes plugin that doesn't declare agent access",
	"channels": [
		"mcp",
		"cli"
	],
	"steps": [
		{
			"call": "toolbelt_status",
			"expect": {
				"contains": [
					"2 more plugins are not available to agents"
				],
				"absent": [
					"Jot (jot)"
				]
			}
		},
		{
			"call": "read_screen",
			"args": {
				"plugin": "jot"
			},
			"expect": {
				"refused": true,
				"contains": [
					"No plugin \"jot\" is available to agents"
				]
			}
		},
		{
			"call": "search_screens",
			"args": {
				"query": "plumber"
			},
			"expect": {
				"contains": [
					"Nothing on 6 screens mentions \"plumber\""
				]
			}
		},
		{
			"person": {
				"access": {
					"plugin": "jot",
					"level": "read"
				}
			}
		},
		{
			"call": "read_screen",
			"args": {
				"plugin": "jot"
			},
			"expect": {
				"contains": [
					"# Jot › Notes",
					"Call the plumber about the kitchen tap"
				]
			}
		},
		{
			"call": "list_plugins",
			"expect": {
				"contains": [
					"Jot (jot) 0.9.0"
				]
			}
		},
		{
			"person": {
				"access": {
					"plugin": "jot",
					"level": null
				}
			}
		},
		{
			"call": "read_screen",
			"args": {
				"plugin": "jot"
			},
			"expect": {
				"refused": true
			}
		}
	],
	"expect": {
		"audit": [
			{
				"operation": "read_screen",
				"plugin": "jot",
				"outcome": "denied"
			},
			{
				"operation": "read_screen",
				"plugin": "jot",
				"outcome": "ok"
			},
			{
				"operation": "read_screen",
				"plugin": "jot",
				"outcome": "denied"
			}
		]
	},
	"rubric": [
		"Says the notes plugin isn't shared with agents and that the person can allow it under Settings → Agents → Access.",
		"After access is allowed: lists the two notes."
	],
	"origin": {
		"run": "fixtures",
		"case": "new",
		"plugins": [
			"jot"
		],
		"channel": "MCP and CLI",
		"calls": [],
		"verdict": "new"
	}
}

{
	"id": "19-agent-views",
	"title": "The agent searches and filters its own view",
	"prompt": "Is renewing my passport done or still open?",
	"persona": "Person chatting with Claude Desktop while their Desk window searches for \"finance\"",
	"channels": [
		"mcp",
		"cli"
	],
	"setup": {
		"person": [
			{
				"open": "desk/tasks"
			},
			{
				"event": {
					"screen": "desk/tasks",
					"name": "search",
					"payload": {
						"query": "finance"
					}
				}
			}
		]
	},
	"steps": [
		{
			"call": "list_screens",
			"args": {
				"plugin": "desk"
			},
			"expect": {
				"contains": [
					"view: search; filter \"status\" [open, waiting, done] (default open, waiting); sort \"tasks\" by title"
				]
			}
		},
		{
			"call": "read_screen",
			"args": {
				"plugin": "desk",
				"view": {
					"search": "passport",
					"filters": {
						"status": []
					}
				}
			},
			"expect": {
				"contains": [
					"Your view: search \"passport\"; Status: all.",
					"Renew passport"
				],
				"absent": [
					"Q4 budget review",
					"currently showing"
				]
			}
		},
		{
			"call": "read_screen",
			"args": {
				"plugin": "desk",
				"view": {
					"filters": {
						"status": [
							"archived"
						]
					}
				}
			},
			"expect": {
				"refused": true,
				"contains": [
					"Filter \"status\" has no option \"archived\". Its options: open (Open), waiting (Waiting), done (Done)."
				]
			}
		},
		{
			"call": "read_screen",
			"args": {
				"plugin": "desk",
				"view": {
					"filters": {
						"label": [
							"home"
						]
					}
				}
			},
			"expect": {
				"refused": true,
				"contains": [
					"This screen has no filter \"label\". Its filters: status."
				]
			}
		},
		{
			"call": "read_screen",
			"args": {
				"plugin": "desk",
				"view": {
					"sort": {
						"tasks": "-title"
					}
				}
			},
			"expect": {
				"contains": [
					"Your view: tasks sorted by -title."
				]
			}
		},
		{
			"call": "read_screen",
			"args": {
				"plugin": "desk",
				"view": "person",
				"details": false
			},
			"expect": {
				"contains": [
					"The person's view, currently showing search \"finance\"",
					"Q4 budget review with finance"
				],
				"absent": [
					"Renew passport"
				],
				"personView": {
					"screen": "desk/tasks",
					"view": {
						"search": "finance"
					}
				}
			}
		}
	],
	"expect": {
		"audit": [
			{
				"operation": "read_screen",
				"outcome": "ok"
			},
			{
				"operation": "read_screen",
				"outcome": "denied"
			},
			{
				"operation": "read_screen",
				"outcome": "denied"
			},
			{
				"operation": "read_screen",
				"outcome": "ok"
			}
		]
	},
	"rubric": [
		"Finds the passport renewal by searching its own view across every status.",
		"Doesn't change or mention changing the person's search."
	],
	"origin": {
		"run": "fixtures",
		"case": "new",
		"plugins": [
			"desk"
		],
		"channel": "MCP and CLI",
		"calls": [],
		"verdict": "new"
	}
}

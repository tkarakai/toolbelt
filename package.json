{
	"name": "toolbelt",
	"version": "0.0.0",
	"private": true,
	"description": "One app, one menu bar icon, many small tools.",
	"type": "module",
	"scripts": {
		"plugins": "bun scripts/build-plugins.ts",
		"views": "vite build",
		"dev": "bun run plugins && electrobun prepare && vite build && electrobun dev",
		"build": "bun run plugins && electrobun prepare && vite build && electrobun build --env=stable",
		"devkit": "electrobun prepare",
		"typecheck": "tsc --noEmit -p .",
		"test": "bun test",
		"icons": "bun scripts/make-icons.ts && bun scripts/make-app-icon.ts",
		"preview": "bun run plugins && vite build && bun scripts/preview.ts",
		"dmg": "bun scripts/make-dmg.ts",
		"release": "bun scripts/release.ts"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.70.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shadcn": "^4.23.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"electrobun": "2.0.6",
		"tailwindcss": "^4.3.5",
		"typescript": "~5.9.3",
		"vite": "^8.3.7"
	}
}

{
  "name": "toolbelt",
  "version": "0.3.3",
  "private": true,
  "description": "One app, one menu bar icon, many small tools.",
  "type": "module",
  "scripts": {
    "plugins": "bun scripts/prepare-seed.ts",
    "views": "vite build",
    "dev": "TOOLBELT_VARIANT=dev bun run dev:app",
    "build": "TOOLBELT_VARIANT=official bun run build:app",
    "devkit": "electrobun prepare",
    "typecheck": "bun scripts/settings-build-info.ts && bunx electrobun prepare && tsc --noEmit -p .",
    "test": "bun test",
    "icons": "bun scripts/make-icons.ts",
    "preview": "bun run plugins && vite build && bun scripts/preview.ts",
    "dmg": "bun scripts/make-dmg.ts",
    "release": "bun scripts/release.ts",
    "dev:app": "bun run plugins && electrobun prepare && vite build && electrobun dev",
    "build:app": "bun run plugins && electrobun prepare && vite build && electrobun build --env=stable",
    "sdk:package": "bun scripts/build-sdk.ts",
    "release:app": "bun src/release/cli.ts app",
    "release:app:retry": "bun src/release/cli.ts app:retry",
    "release:sdk": "bun src/release/cli.ts sdk",
    "release:sdk:retry": "bun src/release/cli.ts sdk:retry",
    "seed:update": "bun scripts/update-seed.ts",
    "sdk:check": "bun scripts/check-sdk.ts",
    "sdk:typecheck": "tsc --noEmit -p tsconfig.sdk.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electrobun": "2.0.6",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.7"
  }
}
